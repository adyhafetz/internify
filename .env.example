# ==============================================================================
# 🚀 INTERNIFY CONFIGURATION
# Only the first two variables (OPENAI_API_KEY & TELEGRAM_BOT_TOKEN) are required!
# ==============================================================================

# 1. OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# 2. Telegram Bot Token (Required - from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# 3. Security (Recommended)
# Restrict bot commands to your personal Telegram user ID (get it from @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=

# 4. Local SQLite Database Storage (Default out-of-the-box)
DATABASE_PATH=output/internify.db

# 5. LLM Models & Cost Controls
# Any OpenAI chat model works here; just put its name. Four jobs, four settings:
#   EXTRACTOR_MODEL  reads job postings and your resume (also used by the morning scan's Matcher): needs to be accurate, not creative
#   CRITIC_MODEL     checks every resume line against your real experience: the one worth not skimping on
#   GENERATOR_MODEL  writes the resume lines (the Scribe)
#   IMPORT_MODEL     turns your resume file into saved experience (defaults to GENERATOR_MODEL)
# Pick a preset (uncomment one block). Prices are per 1M tokens and change, so check
# https://platform.openai.com/docs/pricing before you rely on them. Model names current as of late 2026.
#
# A) Cheapest, about a cent or less per resume (good for trying it out):
#    EXTRACTOR_MODEL=gpt-5-nano   CRITIC_MODEL=gpt-5-mini   GENERATOR_MODEL=gpt-5-mini
# B) Balanced, the one I'd use day to day:
#    EXTRACTOR_MODEL=gpt-5.4-nano  CRITIC_MODEL=gpt-5.4-mini  GENERATOR_MODEL=gpt-5.4-mini
# C) Best writing, for the jobs you really want:
#    EXTRACTOR_MODEL=gpt-5.4-mini  CRITIC_MODEL=gpt-5.4  GENERATOR_MODEL=gpt-5.5
# Older models such as gpt-4o and gpt-4o-mini also still work. The "gpt-5" family thinks before answering,
# so it's a bit slower per step than gpt-4o.
EXTRACTOR_MODEL=gpt-4o-mini
CRITIC_MODEL=gpt-4o-mini
GENERATOR_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# 6. Agentic Loop Tuning
SCORE_THRESHOLD=85
MAX_GENERATOR_ITERATIONS=3
MAX_TEX_FIX_RETRIES=2
# Ask you in Telegram about tools a job wants that your saved experience lacks (max questions per job):
ASK_ABOUT_MISSING_SKILLS=true
# If a job page is blocked or empty, Scout tries other routes (rendering service, web-archive copy, the same
# posting elsewhere) and finally asks you to paste the text. These routes send the job link to those services.
SCOUT_FALLBACKS=true
# The morning scan: looks at your job watchlist (/profile -> Job watchlist), keeps the best fits, writes resumes.
SCAN_ENABLED=true
SCAN_TIME=08:00
SCAN_TIMEZONE=UTC
SCAN_MAX_TAILORED=3
SCAN_MIN_FIT=0.5
MAX_SKILL_QUESTIONS=2
TECTONIC_TIMEOUT_SECONDS=600
TOP_K_FACTS=10

# 7. Job Scraping & Anti-Bot Bypass (Optional but highly recommended)
# Bypasses Cloudflare & JavaScript protection on Workday, Lever, LinkedIn, etc.
# Free 10,000 requests/month at https://scrapingant.com/
# If left blank, Internify falls back to direct HTTP scraping with browser headers.
SCRAPINGANT_API_KEY=

# ==============================================================================
# ☁️ OPTIONAL CLOUD SYNC (Google Drive Backup & Google Sheets Tracker)
# If left blank, applications and PDFs are tracked locally in SQLite + Telegram.
# ==============================================================================
# 1. Google OAuth2 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 2. Google Sheets Tracker
# Copy our free template: https://docs.google.com/spreadsheets/d/1ozOD9aYl43jPgfGXid_BOmQRXHy8Aiw_eT5JzSwgccQ/edit?usp=sharing
# Click File -> Make a copy, then paste your copied spreadsheet ID here:
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Tracker

# 3. Google Drive Folder
# The ID of the Google Drive folder where tailored PDFs should be saved:
GOOGLE_DRIVE_FOLDER_ID=

# (Optional fallback if using a Service Account JSON instead of OAuth2)
GOOGLE_SERVICE_ACCOUNT_FILE=

# 7. Live Dashboard (open http://localhost:8080 while the bot runs)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
# Required once the site is on the internet. Generate one with:  openssl rand -hex 16
# Then open https://your-domain/live?key=THAT_VALUE once. Leave empty for local-only use.
DASHBOARD_KEY=
# Cloudflare Tunnel token (see docs/domain_setup.md). Only needed for the "tunnel" profile.
CLOUDFLARE_TUNNEL_TOKEN=
