# Internify settings. The setup page (setup.bat / setup.sh) fills this in for you.
# Required: sections 1 and 2. Everything else is optional.

# ── 1. AI ─────────────────────────────────────────────────
# Which AI to use: openai, or gemini (Google's free tier)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=

# AI models. These are OpenAI's; choosing Gemini in the setup page replaces them with Gemini's
EXTRACTOR_MODEL=gpt-5.4-nano
CRITIC_MODEL=gpt-5.4-mini
GENERATOR_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── 2. Telegram ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your Telegram ID (ask @userinfobot) so only you can use the bot
TELEGRAM_ALLOWED_USER_IDS=

# ── 3. Daily job check ────────────────────────────────────
# When it runs (24-hour clock)
SCAN_TIME=08:00
# Your timezone, for example Asia/Kuala_Lumpur
SCAN_TIMEZONE=UTC

# ── 4. Optional extras ────────────────────────────────────
# Reads job pages that block normal visits (free tier at https://scrapingant.com)
SCRAPINGANT_API_KEY=

# Save PDFs to Google Drive and track jobs in Google Sheets. Blank = local only. Guide: docs/domain_setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Tracker
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ── 5. Live dashboard and website ─────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
# Needed only when the dashboard is on the internet: openssl rand -hex 16
DASHBOARD_KEY=
# The public address of your website, only if you use your own domain: https://internify.yourdomain.com
PUBLIC_URL=
# Shown on your privacy page (Google asks for one)
CONTACT_EMAIL=
# Needed only for your own domain, see docs/domain_setup.md
CLOUDFLARE_TUNNEL_TOKEN=
