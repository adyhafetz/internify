# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Models (Defaults are optimal for cost & speed)
EXTRACTOR_MODEL=gpt-4o-mini
CRITIC_MODEL=gpt-4o-mini
GENERATOR_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Agentic Loop Controls
SCORE_THRESHOLD=85
MAX_GENERATOR_ITERATIONS=3
MAX_TEX_FIX_RETRIES=2
TECTONIC_TIMEOUT_SECONDS=600
TOP_K_FACTS=10

# n8n Configuration
# For local development: http://localhost:5678/
# For live server: https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
TZ=Asia/Kuala_Lumpur

# Telegram Bot Token (optional if configuring directly inside n8n credential)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
