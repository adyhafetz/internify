# Internify settings. Only the first two are required.

OPENAI_API_KEY=sk-your-openai-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your Telegram user ID (ask @userinfobot) so only you can use the bot
TELEGRAM_ALLOWED_USER_IDS=

# AI: openai, or gemini (Google's free tier)
AI_PROVIDER=openai
GEMINI_API_KEY=

# AI models
EXTRACTOR_MODEL=gpt-5.4-nano
CRITIC_MODEL=gpt-5.4-mini
GENERATOR_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# Daily job check: when it runs (24h clock) and in which timezone, e.g. Asia/Kuala_Lumpur
SCAN_TIME=08:00
SCAN_TIMEZONE=UTC

# Optional: reads job pages that block normal visits (free tier at https://scrapingant.com)
SCRAPINGANT_API_KEY=

# Optional: save PDFs to Google Drive and track jobs in Google Sheets (see README). Blank = local only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Tracker
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Live dashboard at http://localhost:8080/live
DASHBOARD_ENABLED=true
# Shown on your privacy page as how to reach you (Google asks for one)
CONTACT_EMAIL=
DASHBOARD_PORT=8080
# Only needed when the dashboard is on the internet: openssl rand -hex 16
DASHBOARD_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
